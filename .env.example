# Copiar a .env (opcional: docker compose usa valores por defecto equivalentes)
POSTGRES_USER=gidr
POSTGRES_PASSWORD=gidr
POSTGRES_DB=gidr
JWT_SECRET=cambiar-este-secreto-en-produccion-0123456789
AUTO_SEED=true
CORS_ORIGENES=http://localhost:3000,http://localhost:5173
